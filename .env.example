# -----------------------------------------------------------------------------
# TalentFlow environment
# Copy to .env.local and fill in. .env.local is git-ignored.
# -----------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijkl.supabase.co
# Safe in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon / publishable key.
# Safe in the browser: every query it makes is still filtered by Row Level
# Security against the signed-in user.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key. SERVER ONLY.
# Bypasses Row Level Security and can call the Auth Admin API. Used by
# POST /api/admin/users and by the scripts in scripts/. Never prefix this with
# NEXT_PUBLIC_ and never expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI API key. SERVER ONLY. Optional.
# Without it the rest of the ATS works normally and the AI panel reports that
# AI Match Analysis is not configured in this environment.
OPENAI_API_KEY=

# Optional: override the model used for AI Match Analysis.
# Defaults to gpt-4.1-mini.
OPENAI_MODEL=

# Postgres connection string. SERVER / CLI ONLY. Optional.
# Used only by the setup scripts (db:push, verify-schema) - the app itself never
# connects to Postgres directly, it goes through Supabase with the anon key so
# that RLS applies.
#
# Supabase dashboard -> Connect -> ORM/psql. Note that the direct host
# (db.<ref>.supabase.co) is IPv6-only; if your network has no routable IPv6
# address, use the Session pooler string instead:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
